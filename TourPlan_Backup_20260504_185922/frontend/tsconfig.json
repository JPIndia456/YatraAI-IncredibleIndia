{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "lib/mcp/index.ts",
    "lib/mcp/testFunctions.ts",
    "lib/mcp/dataValidation.ts",
    "lib/mcp/railwayUtils.ts",
    "lib/mcp/railwayService.ts",
    "supabase",
    "indian-railways-mcp",
    "indian-bhashini-mcp",
    "flights-mcp-server",
    "bhashini-mcp-server"
  ]
}
