'use client';

import { motion, AnimatePresence } from 'framer-motion';
import { 
  Sparkles, 
  Send, 
  User, 
  Bot, 
  ChevronRight, 
  MapPin, 
  Calendar, 
  CreditCard,
  Volume2,
  VolumeX,
  RefreshCcw,
  MessageSquare,
  Compass,
  Zap,
  CheckCircle2,
  Hotel,
  Plane,
  Train,
  ShoppingCart,
  Trash2,
  History,
  X
} from 'lucide-react';
