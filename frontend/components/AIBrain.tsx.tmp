// ── Components ───────────────────────────────────────────────────────────────

/**
 * DiscoveryCard: Renders a structured recommendation from the AI.
 */
function DiscoveryCard({ data, onSelect }: { data: any, onSelect: (d: any) => void }) {
  const { type, name, price, stars, features, link } = data;
  const Icon = type === 'hotel' || type === 'stay' ? Hotel : type === 'air' ? Plane : type === 'rail' ? Train : Compass;
  
  return (
    <div className="bg-white rounded-[2rem] p-0 overflow-hidden shadow-2xl border border-slate-50 hover:border-[#FF9933]/20 transition-all group mt-4">
      <div className="p-5">
        <div className="flex items-center justify-between mb-4">
          <div className="flex items-center gap-2">
            <div className="w-8 h-8 rounded-full bg-[#138808]/10 flex items-center justify-center">
              <Icon className="w-4 h-4 text-[#138808]" />
            </div>
            <span className="text-[10px] font-black text-[#000080] uppercase tracking-widest italic">AI Discovery</span>
          </div>
          {stars && (
            <div className="flex gap-0.5">
              {[...Array(Number(stars))].map((_, i) => <Sparkles key={i} className="w-2.5 h-2.5 text-[#FF9933]" />)}
            </div>
          )}
        </div>
        
        <div className="flex justify-between items-start gap-4">
          <div className="flex-1">
            <div className="w-12 h-12 rounded-2xl bg-[#FF9933]/5 flex items-center justify-center border border-[#FF9933]/10">
              <Icon className="w-6 h-6 text-[#FF9933]" />
            </div>
            <div className="mt-3">
              <h4 className="text-xl font-black text-[#000080] uppercase tracking-tighter leading-none">{name}</h4>
              <p className="text-[10px] text-[#000080]/40 font-bold uppercase tracking-wider mt-1">{features?.replace(/_/g, ' ')}</p>
            </div>
          </div>
          <div className="text-right shrink-0">
             <p className="text-[9px] font-black text-[#000080]/30 uppercase tracking-widest leading-none mb-1">Est. Price</p>
             <p className="text-lg font-black text-[#138808] uppercase tracking-tighter">₹{price}</p>
          </div>
        </div>

        <button 
          onClick={() => onSelect(data)}
          className="w-full mt-5 py-4 bg-[#FF9933] text-white rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-[#FF8000] transition-all shadow-lg shadow-[#FF9933]/20 active:scale-95 flex items-center justify-center gap-2"
        >
          {link ? <Zap className="w-3.5 h-3.5" /> : <PlusCircle className="w-3.5 h-3.5" />}
          Select this Option
        </button>
      </div>
    </div>
  );
}

